import 'package:flutter/material.dart';

class LoginPage extends StatelessWidget {
  const LoginPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Login'),
      ),
      body: Padding(
        // 3. Espaçamento alterado: era EdgeInsets.all(16), agora 24
        padding: const EdgeInsets.all(24),
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Icon(
              Icons.lock,
              // 1. Tamanho do ícone alterado: era 80, agora 120
              size: 120,
            ),

            // 3. Espaçamento alterado: era 20, agora 30
            const SizedBox(height: 30),

            const TextField(
              decoration: InputDecoration(
                labelText: 'Email',
              ),
            ),

            const SizedBox(height: 10),

            const TextField(
              obscureText: true,
              decoration: InputDecoration(
                labelText: 'Senha',
              ),
            ),

            const SizedBox(height: 8),

            // 4. Texto adicionado: "Esqueceu a senha?"
            Align(
              alignment: Alignment.centerRight,
              child: TextButton(
                onPressed: () {},
                child: const Text('Esqueceu a senha?'),
              ),
            ),

            const SizedBox(height: 20),

            ElevatedButton(
              onPressed: () {},
              // 2. Texto do botão alterado: era 'Entrar', agora 'Acessar'
              child: const Text('Acessar'),
            ),

            const SizedBox(height: 12),

            // 5. Segundo botão adicionado
            OutlinedButton(
              onPressed: () {},
              child: const Text('Criar conta'),
            ),
          ],
        ),
      ),
    );
  }
}

